# Copy this file to android-app/keystore.properties (that copy is gitignored).
# Paths are relative to android-app/, the folder that contains this file.
# Environment variables override the file when they are set:
#   KAYAN_STORE_FILE  KAYAN_STORE_PASSWORD  KAYAN_KEY_ALIAS  KAYAN_KEY_PASSWORD
# Debug builds do not read this. Do not commit the real passwords.
storeFile=keystore/kayan-release.jks
storePassword=
keyAlias=kayan
keyPassword=
